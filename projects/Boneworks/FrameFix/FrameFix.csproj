<Project Sdk="Microsoft.NET.Sdk" DefaultTargets="BuildAll">
  <Target Name="BuildAll">
    <MSBuild Projects="$(MSBuildProjectFile)" Targets="Build"
      Properties="Configuration=$(Configuration);MelonLoader=5" />
  </Target>

  <PropertyGroup>
    <CopyIntoGameAfterBuild>true</CopyIntoGameAfterBuild>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ProjectGuid>{7691E80B-F5BD-43D7-BD04-438EC93C7FB4}</ProjectGuid>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="native-input/bin/$(Configuration)/net472/FrameFix.InputCapture.exe"
      LogicalName="FrameFix.InputCapture.exe" />
    <Compile Include="AppVersion.cs" />
    <Compile Include="src/**/*.cs" Exclude="src/Debug/**/*.cs" />
    <Compile Include="src/Debug/**/*.cs" Exclude="src/Debug/Gunfly/**/*.cs" Condition=" '$(Configuration)' == 'Debug' " />
    <Compile Include="../../../common/Utilities/Metadata.cs" />
    <Compile Include="../../../common/Boneworks/Il2CppNullable.cs" Condition=" '$(Configuration)' == 'Debug' " />
  </ItemGroup>
  <Target Name="BuildInputCapture" BeforeTargets="PrepareForBuild">
    <MSBuild Projects="native-input/FrameFix.InputCapture.csproj" Targets="Restore;Build"
      Properties="Configuration=$(Configuration)" />
  </Target>
</Project>
