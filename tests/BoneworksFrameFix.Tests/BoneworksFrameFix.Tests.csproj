      Link="PendingPreferenceChanges.cs" />
    <Compile Include="../../projects/Boneworks/BoneworksFrameFix/src/Tracking/PoseHistoryTypes.cs"
      Link="PoseHistoryTypes.cs" />
    <!-- Pure diagnostic utilities are tested here but excluded from the Release mod. -->
    <Compile Include="../../projects/Boneworks/BoneworksFrameFix/src/Debug/Profiling/PoseHistoryUtilities.Debug.cs"
      Link="PoseHistoryUtilities.Debug.cs" />
